   "version": 1,
   "versionNonce": 972801992,
   "boundElements": [],
   "text": "A promotion that lands OUTSIDE this kit is a success, not a leak.\nA recurring correction that turns out to be a team convention\nbelongs to the team; one that turns out to be mechanically\ncheckable belongs in the check. Either way it leaves the log.\n\nlast_reviewed going stale is the signal to re-verify a file\nbefore trusting it \u2014 drift you can see beats drift you cannot.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "note4",
   "originalText": "A promotion that lands OUTSIDE this kit is a success, not a leak.\nA recurring correction that turns out to be a team convention\nbelongs to the team; one that turns out to be mechanically\ncheckable belongs in the check. Either way it leaves the log.\n\nlast_reviewed going stale is the signal to re-verify a file\nbefore trusting it \u2014 drift you can see beats drift you cannot.",
   "autoResize": false,
   "lineHeight": 1.25
  },
