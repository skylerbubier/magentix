   "boundElements": [],
   "text": "id             PF-0117\ncategory       capability\nstatement      the durable shape\n               of the fact\ndetail         its current value \u2014\n               split so a number\n               moving is not a\n               supersession\nverification\n   method      observed | pointer |\n               asserted | untestable\n   how         REQUIRED for observed\n   last_result what it showed\nauthority      who can CHANGE it \u2014\n               not who watches it\nlast_verified  drives the interval",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "id             PF-0117\ncategory       capability\nstatement      the durable shape\n               of the fact\ndetail         its current value \u2014\n               split so a number\n               moving is not a\n               supersession\nverification\n   method      observed | pointer |\n               asserted | untestable\n   how         REQUIRED for observed\n   last_result what it showed\nauthority      who can CHANGE it \u2014\n               not who watches it\nlast_verified  drives the interval",
   "autoResize": false,
   "lineHeight": 1.25
  },
