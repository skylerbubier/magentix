   "version": 1,
   "versionNonce": 1133040876,
   "boundElements": [],
   "text": "Project facts are mostly readable, so the format insists\nyou say whether you checked. An `observed` label with no\n`how` is an assertion claiming a strength it never earned.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
