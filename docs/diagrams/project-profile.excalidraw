   "seed": 1117738418,
   "version": 1,
   "versionNonce": 948917259,
   "boundElements": [],
   "text": "Verify by VIOLATING it. Reading configuration proves the\nmechanism exists; being denied proves it works \u2014 and only\nthe second earns `fails_closed: true`.\n\nA check that only reports is instrumentation. A control with\nan available bypass holds against accident, not against\npressure \u2014 and pressure is when it matters.\n\nOne-month interval: the shortest here, deliberately. These\nfacts drift in the dangerous direction, and silently.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Verify by VIOLATING it. Reading configuration proves the\nmechanism exists; being denied proves it works \u2014 and only\nthe second earns `fails_closed: true`.\n\nA check that only reports is instrumentation. A control with\nan available bypass holds against accident, not against\npressure \u2014 and pressure is when it matters.\n\nOne-month interval: the shortest here, deliberately. These\nfacts drift in the dangerous direction, and silently.",
   "autoResize": false,
   "lineHeight": 1.25
  },
