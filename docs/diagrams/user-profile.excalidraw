   "versionNonce": 142230573,
   "boundElements": [],
   "text": "id           UC-0042\ncategory     interaction\nstatement    one fact, behaviourally\n             comparable\nrationale    why \u2014 this is what lets\n             it generalize\nscope        global | domain | task |\n             stakes\nweight       default | strong | firm\n             none of these enforce\nstability    provisional | calibrating\n             | stable\nsource       corrected > observed >\n             stated > inferred\nevidence     required for corrected\n             and inferred\nconfirmed    drives staleness",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "id           UC-0042\ncategory     interaction\nstatement    one fact, behaviourally\n             comparable\nrationale    why \u2014 this is what lets\n             it generalize\nscope        global | domain | task |\n             stakes\nweight       default | strong | firm\n             none of these enforce\nstability    provisional | calibrating\n             | stable\nsource       corrected > observed >\n             stated > inferred\nevidence     required for corrected\n             and inferred\nconfirmed    drives staleness",
   "autoResize": false,
   "lineHeight": 1.25
  },
