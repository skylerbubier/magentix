   "version": 1,
   "versionNonce": 1399756256,
   "boundElements": [],
   "text": "Agent config steers; it never widens.\nA guidance file, a preference doc, or an\ninstruction in the conversation can make\nthe agent more cautious than these rules.\nNone of them can lift a deny.\n\nThe agent's own working notes are exempt\nfrom the path rules \u2014 they are not\nproject content, and an agent that cannot\nwrite them cannot hand off work.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Agent config steers; it never widens.\nA guidance file, a preference doc, or an\ninstruction in the conversation can make\nthe agent more cautious than these rules.\nNone of them can lift a deny.\n\nThe agent's own working notes are exempt\nfrom the path rules \u2014 they are not\nproject content, and an agent that cannot\nwrite them cannot hand off work.",
   "autoResize": false,
   "lineHeight": 1.25
  }
